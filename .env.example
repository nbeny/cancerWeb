# --- Base ---
NODE_ENV=development
DATABASE_URL=postgresql://cancerweb:cancerweb@127.0.0.1:5432/cancerweb?schema=public
TEST_DATABASE_URL=postgresql://cancerweb:cancerweb@127.0.0.1:5434/cancerweb_test?schema=public
REDIS_URL=redis://127.0.0.1:6379

# --- API ---
API_PORT=4000
PUBLIC_ORIGIN=http://localhost:3000
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
COOKIE_SECURE=false
GRAPHQL_MAX_DEPTH=8
GRAPHQL_MAX_COMPLEXITY=1000
RATE_LIMIT_TTL=60
RATE_LIMIT_LIMIT=200

# --- Web ---
WEB_PORT=3001
API_INTERNAL_URL=http://localhost:4000/graphql
REVALIDATE_SECRET=change-me-revalidate-secret

# --- IA (Lot 2) ---
# Contrat CLI validé par docs/ai-cli-smoke-test.md (opencode 1.18.18) :
# le prompt passe par stdin, l'agent écrit lui-même output.md dans son
# répertoire de travail, stdout n'est conservé que comme log de debug.
AI_PROVIDER=fake
AI_MODEL=opencode/hy3-free
AI_CLI_COMMAND=opencode
AI_CLI_ARGS=["run","-m","{model}"]
AI_CLI_PROMPT_VIA=stdin
AI_CLI_TIMEOUT_MS=300000
AI_CLI_MAX_CONCURRENCY=1
AI_WORKSPACE_DIR=./.ai-workspace
